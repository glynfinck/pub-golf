# Where the app is served from. Only used to build absolute URLs in metadata —
# an Open Graph image cannot be advertised at a relative path. Defaults to the
# production domain, so a preview deploy that wants its own cards sets this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — local dev values come from `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, and never used by the app itself — this is a test credential.
# The e2e suite mints host sessions with the admin API (Google's consent screen
# cannot be driven in CI), and the db suite reads rows back past RLS with it to
# prove a blocked write really was blocked.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in. Hosts sign in with Google and guests join anonymously, so
# there is no email in the auth path at all. Create an OAuth client in Google
# Cloud with http://127.0.0.1:54331/auth/v1/callback as an authorized redirect
# URI; `supabase start` reads these two into supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Google Maps Platform, browser side. The key powers the course builder's
# map sheet (Maps JavaScript API; referrer-restrict it to the app's
# domains — it is a different key from the server's Places key below).
# Leave it empty and the builder stays list-only. The map IDs carry the two
# cloud styles authored from the tokens in app/globals.css (masters in
# docs/map-styles/) — either two IDs styled one each, or one ID holding
# both its light and dark styles, set into both variables; the map's
# colorScheme picks the variant. Each falls back to the other, then to
# Google's stock look.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_CREAM=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_MIDNIGHT=
# Server-only — never NEXT_PUBLIC. Google Cloud key with "Places API (New)"
# enabled; application restriction must be None or IP addresses (website
# restrictions block server-side calls). Without it the course builder
# degrades to add-by-name, which still works.
GOOGLE_PLACES_API_KEY=
